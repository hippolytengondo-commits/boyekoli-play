{
  "name": "gestion360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "db:setup": "node --env-file=.env scripts/db-setup.mjs",
    "admin:create": "node --env-file=.env scripts/create-platform-admin.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "test:db:prepare": "DIRECT_URL=$(grep ^DIRECT_URL .env.test | cut -d'\"' -f2) DATABASE_URL=$(grep ^DATABASE_URL .env.test | cut -d'\"' -f2) prisma migrate deploy",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
