# Connexion de l'application : rôle NON propriétaire, sans BYPASSRLS (la RLS s'applique).
DATABASE_URL="postgresql://g360_app:CHANGER_MOI@localhost:5432/gestion360?schema=public"
# Connexion des migrations : propriétaire du schéma.
DIRECT_URL="postgresql://g360:CHANGER_MOI@localhost:5432/gestion360?schema=public"
# Mot de passe du rôle applicatif (utilisé par scripts/db-setup.mjs).
APP_DB_PASSWORD="CHANGER_MOI"
# URL publique (contrôle d'origine CSRF, liens des e-mails).
APP_URL="http://localhost:3000"
# Transport d'e-mail : "console" (journal serveur, développement/test) — SMTP à configurer en phase 9.
MAIL_TRANSPORT="console"
SESSION_TTL_HOURS="168"
